{
  "manifest_version": 3,
  "name": "Detailed SEO & AI Engine - Waqas Mehmood",
  "version": "1.0.1",
  "description": "Comprehensive On-Page SEO, Schema, and AI search readiness audit tool for modern websites by Waqas Mehmood.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Detailed SEO & AI Engine - Waqas Mehmood",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
