<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Custom 404 Error Document
    ErrorDocument 404 /404.html

    # Serve existing files directly (HTML, CSS, JS, XML, TXT, PNG, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Map /detailed-seo-ai to index.html
    RewriteRule ^detailed-seo-ai/?$ index.html [L]

    # Map /privacy to privacy.html
    RewriteRule ^privacy/?$ privacy.html [L]

    # Root requests map to index.html
    RewriteRule ^$ index.html [L]
</IfModule>
