{
  "manifest_version": 3,
  "name": "Detailed SEO & AI Engine - Waqas Mehmood",
  "short_name": "Detailed SEO",
  "version": "1.0.0",
  "description": "Inspect On-Page SEO, H1-H6 heading hierarchy, JSON-LD schema, links, images, and 2026 AI/AEO citability readiness in 1 click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Detailed SEO & AI Engine - Waqas Mehmood",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
