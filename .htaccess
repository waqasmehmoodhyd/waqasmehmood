# Set DirectoryIndex so React index.html takes priority over WordPress index.php
DirectoryIndex index.html index.php

# Security Headers (A+ Security Grade & Screaming Frog Compliance)
<IfModule mod_headers.c>
    # 1. HTTP Strict Transport Security (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # 2. Prevent MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # 3. Clickjacking Protection
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # 4. Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # 5. Permissions Policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Proper MIME Types (Avoid Bad Content Type Warnings)
<IfModule mod_mime.c>
    AddType text/html .html
    AddType text/css .css
    AddType application/javascript .js
    AddType application/json .json
    AddType application/xml .xml
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType image/x-icon .ico
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block access to sensitive configuration, database and git files
    <FilesMatch "(^\.env|\.git|\.sqlite|\.sqlite3|composer\.(json|lock)|package(-lock)?\.json)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # 2. Block and permanently remove legacy casino/gambling spam URLs with HTTP 410 Gone (Fast de-index in Google Search Console)
    RewriteCond %{REQUEST_URI} (casino|gambling|slots?|baccarat|blackjack|roulette|rummy|betting|1x2gaming|bluberi|push-gaming|thunderkick|merkur|dragon-tiger|fruit-million|wild-spin|5-reel-drive|moon-princess|bonus-codes|free-chips|fire-strike|24k-casino|big-bass|neogames|red-rake|quickfire|playtech|gamesys|random-logic|best-online-game|mobile-phone-bill-new-zealand) [NC]
    RewriteRule ^ - [G,L]

    # 3. Route all API requests to the Laravel backend entrypoint
    RewriteCond %{REQUEST_URI} ^/api(/.*)?$
    RewriteRule ^api(/.*)?$ backend/public/index.php [L,QSA]

    # 4. Serve actual existing files or directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4b. Pre-rendered HTML route matching (e.g. /services -> services/index.html)
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.*)/?$ $1/index.html [L]

    # 5. Fallback to index.html for React SPA client-side routing
    RewriteRule ^ index.html [L]
</IfModule>

# Compression for high PageSpeed performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>

# Browser Caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
